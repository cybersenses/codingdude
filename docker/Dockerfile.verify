# Bare-machine verification of CodingDude's install path (Linux equivalent).
# Mirrors setup-codingdude.bat steps that are platform-independent.
FROM python:3.12-slim

# uv (step 1) + Node for frontend build (step 4)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/
RUN apt-get update \
 && apt-get install -y --no-install-recommends nodejs npm ca-certificates git curl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Full source is required up front: uv-build needs it (no dep-only layer).
COPY . .
RUN uv sync --frozen

# Gates run interactively after build (see ROADMAP.md R56 / code-design.md):
# pytest OOM-kills the default docker build, so we don't bake them in.

# Frontend build (step 7)
WORKDIR /app/frontend
RUN npm ci && npm run build

# Boot the server (step: start-codingdude.bat equivalent).
# Server binds 127.0.0.1 only (server.py HOST) — check from inside:
#   docker build -t codingdude-verify -f docker/Dockerfile.verify .
#   docker run -d --name cdv codingdude-verify
#   docker exec cdv curl -sf http://127.0.0.1:8765/health
WORKDIR /app
ENV CODEDUDE_HOME=/root/.codingdude
# UI/API stay on loopback (server.py HOST binds 127.0.0.1); use docker exec.
EXPOSE 8765
CMD ["uv", "run", "python", "-m", "codingdude.cli", "serve", "--port", "8765"]
